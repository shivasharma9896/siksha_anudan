rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function validImage() {
      return request.resource != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /studentPhotos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /studentDocuments/{uid}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /donorDocuments/{uid}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('(image/.*|application/pdf)');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
